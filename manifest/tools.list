# ─────────────────────────────────────────────────────────────────────────────
# tools.list — 설치할 오픈소스 도구 (CLI, MCP 서버 등)
#
# 형식 (파이프 구분, 앞뒤 공백 무시, '#' 으로 시작하면 주석):
#   name | check | install | tags | description
#
#   name        : 도구 이름 (표시용)
#   check       : 이미 설치됐는지 확인하는 셸 명령. 종료코드 0 이면 설치 건너뜀
#   install     : 설치 셸 명령
#   tags        : 분류 태그 (쉼표 구분). bootstrap.sh --tag <tag> 로 필터링 가능
#   description : 한 줄 설명
#
# 고정 규칙 (validate.sh 가 검사한다): 도구는 설치 시점의 최신판이 아니라 정해진 것으로 설치한다.
#   npm 은 `npm install -g 패키지@버전`, uv 는 `uv tool install 패키지==버전`(또는 git+…@<40자리 커밋>), npx 는 `패키지@버전`,
#   git clone 은 40자리 커밋 체크아웃, 받아서 실행하는 스크립트는 `bash "$AI_SETUP_ROOT/scripts/fetch-verified.sh" <url> <sha256>`.
#   check 는 "있다"가 아니라 "그 버전이다"를 확인한다(npm: `npm ls -g --depth=0 패키지@버전`, uv: `uv tool list | grep -q '^이름 v버전$'`).
#   고정할 수 없으면 tags 에 `unpinned`, 설명에 `미고정: 사유` 를 적는다.
# 주의: install 은 그대로 셸에서 실행됩니다. 신뢰할 수 있는 명령만 적으세요.
# install 이 종료 코드 75 로 끝나면 '선행 조건 미충족으로 건너뜀'으로 보고하고 실패로 세지 않는다
# (예: Node 버전이 낮음). 사유는 install 이 stderr 에 직접 출력한다. 그 밖의 0 이 아닌 코드는 실패다.
# 셸 파이프(|)를 쓰려면 '\|' 로 이스케이프. '||' 는 구분자로 취급하지 않으므로 그대로 사용.
# ─────────────────────────────────────────────────────────────────────────────

skills-cli | npm ls -g --depth=0 skills@1.7.1 >/dev/null 2>&1 | npm install -g skills@1.7.1 | core | Agent Skills 설치 CLI (skills.sh). bootstrap 이 스킬 설치에 사용
agent-browser | npm ls -g --depth=0 agent-browser@0.38.2 >/dev/null 2>&1 | npm install -g agent-browser@0.38.2 | browser | AI 에이전트용 브라우저 자동화 CLI (Vercel Labs)

# --- Python / RAG ---------------------------------------------------------------
uv | command -v uv >/dev/null 2>&1 || [ -x "$HOME/.local/bin/uv" ] | bash "$AI_SETUP_ROOT/scripts/fetch-verified.sh" https://github.com/astral-sh/uv/releases/download/0.12.23/uv-installer.sh b8e6c43099ee9f9a550984d3ad56948457c689e7a99c090b35377234ac241491; rc=$?; if [ "$rc" = 3 ]; then python3 -m pip install --user --break-system-packages 'uv==0.12.23'; else exit "$rc"; fi | python,core | 빠른 Python 패키지/도구 관리자 (Astral). 공식 설치 스크립트가 막히면 pip 로 폴백. leann·markitdown 설치에 사용
leann | export PATH="$HOME/.local/bin:$PATH"; uv tool list 2>/dev/null \| grep -q '^leann-core v0.3.8$' | export PATH="$HOME/.local/bin:$PATH"; uv tool install --force 'leann-core==0.3.8' --with 'leann==0.3.8' | rag,search,python | 저장공간 97% 절감(업스트림 주장, 미검증) 로컬 벡터 DB. 코드/문서/메일을 시맨틱 검색·RAG (StarTrail-org/LEANN)
leann-mcp     | command -v claude >/dev/null 2>&1 && claude mcp list 2>/dev/null \| grep -q leann-server | export PATH="$HOME/.local/bin:$PATH"; if ! command -v claude >/dev/null 2>&1; then echo "skip: claude CLI not installed"; elif ! command -v leann_mcp >/dev/null 2>&1; then echo "error: leann_mcp not found (leann install failed?)" >&2; exit 1; else claude mcp add --scope user leann-server -- leann_mcp; fi | rag,search,mcp | LEANN 을 Claude Code MCP 서버(leann-server)로 등록. leann 이 설치된 경우에만 등록. 코드베이스 시맨틱 검색을 에이전트가 직접 사용

# --- 문서 변환 -------------------------------------------------------------------
markitdown | export PATH="$HOME/.local/bin:$PATH"; uv tool list 2>/dev/null \| grep -q '^markitdown v0.1.8$' | export PATH="$HOME/.local/bin:$PATH"; uv tool install --force 'markitdown[all]==0.1.8' | docs,python | PDF/Word/PPT/Excel/HTML 등을 Markdown 으로 변환하는 CLI (Microsoft)

# --- MCP 서버 (Claude Code) ---------------------------------------------------------
context7-mcp | command -v claude >/dev/null 2>&1 && claude mcp list 2>/dev/null \| grep -q '^context7' | if command -v claude >/dev/null 2>&1; then timeout 180 npx -y @upstash/context7-mcp@4.2.0 </dev/null >/dev/null 2>&1 || true; claude mcp add --scope user context7 -- npx -y @upstash/context7-mcp@4.2.0; else echo "skip: claude CLI not installed"; fi | mcp,docs | 라이브러리 최신 공식 문서를 에이전트에 실시간 제공하는 MCP (Upstash Context7)
playwright-mcp | command -v claude >/dev/null 2>&1 && claude mcp list 2>/dev/null \| grep -q '^playwright' | if command -v claude >/dev/null 2>&1; then timeout 180 npx -y @playwright/mcp@0.0.83 --version </dev/null >/dev/null 2>&1 || true; claude mcp add --scope user playwright -- npx -y @playwright/mcp@0.0.83; else echo "skip: claude CLI not installed"; fi | mcp,browser | 에이전트가 실제 브라우저를 조작·검증하는 MCP (Microsoft Playwright)

# --- 코드 이해 / 문서 / ML --------------------------------------------------------
graphify | export PATH="$HOME/.local/bin:$PATH"; uv tool list 2>/dev/null \| grep -q '^graphifyy v0.9.79$' | export PATH="$HOME/.local/bin:$PATH"; uv tool install --force 'graphifyy==0.9.79' && graphify install | code,graph,python | 코드·문서를 질의 가능한 지식 그래프로 변환 (tree-sitter, 벡터 DB 불필요). graphify install 로 /graphify 스킬 등록 (PyPI 패키지명은 graphifyy)
llmfit | export PATH="$HOME/.local/bin:$PATH"; uv tool list 2>/dev/null \| grep -q '^llmfit v1.1.16$' | export PATH="$HOME/.local/bin:$PATH"; uv tool install --force 'llmfit==1.1.16' | ml,local-llm,python | 내 하드웨어(CPU/RAM/GPU)에서 돌아가는 오픈 LLM 을 양자화별로 추천
kordoc | npm ls -g --depth=0 kordoc@4.19.2 >/dev/null 2>&1 | npm install -g kordoc@4.19.2 | docs,korean | 한국 문서 HWP·HWPX·PDF·Office·이미지(OCR) 를 Markdown/JSON 으로 변환
officecli | npm ls -g --depth=0 @officecli/officecli@1.0.153 >/dev/null 2>&1 | npm install -g @officecli/officecli@1.0.153 && officecli config autoUpdate false | docs,office | AI 에이전트용 Word/Excel/PowerPoint 읽기·편집·자동화 CLI (내장 렌더링, 수식 계산). 버전을 고정하고 자동 업데이트를 끈다(기본값은 켜짐이라 시간이 지나면 환경마다 버전이 달라진다)

# --- 리서치 -----------------------------------------------------------------------
hyperresearch | export PATH="$HOME/.local/bin:$PATH"; uv tool list 2>/dev/null \| grep -q '^hyperresearch v0.12.0$' && [ -f "$HOME/.claude/skills/hyperresearch/SKILL.md" ] | export PATH="$HOME/.local/bin:$PATH"; uv tool install --force 'hyperresearch==0.12.0' && hyperresearch install --global | research,python | Claude Code 를 딥 리서치 에이전트로 전환 (16단계 파이프라인, 인용 검증). --global 로 ~/.claude 에 /hyperresearch 스킬과 에이전트만 설치, 프로젝트는 건드리지 않음


# --- 에이전트 오케스트레이션 / 코드베이스 컨텍스트 ------------------------------------
paperclipai | npm ls -g --depth=0 paperclipai@2026.1005.0 >/dev/null 2>&1 | node -e "const [a,b]=process.versions.node.split('.').map(Number);process.exit(a>24||(a===24&&b>=11)?0:1)" || { echo 'paperclipai: Node 24.11 이상이 필요해 건너뜁니다 (현재 '$(node -v)'). Node 를 올린 뒤 bootstrap.sh --tools-only 를 다시 실행하세요.' >&2; exit 75; }; npm install -g paperclipai@2026.1005.0 | agents,orchestration | AI 에이전트 팀을 조직도·예산·목표로 관리하는 Node 서버+React UI 의 CLI. 설치는 CLI 만 하고, 서버 시작은 직접 `paperclipai onboard` (내장 Postgres 와 설정 파일을 만든다)
graft | npm ls -g --depth=0 @nanonets/graft@0.21.1 >/dev/null 2>&1 \|\| { command -v graft >/dev/null 2>&1 && graft --version 2>/dev/null \| grep -q '^0.21.1$'; } | DO_NOT_TRACK=1 npm install -g @nanonets/graft@0.21.1 || { command -v graft >/dev/null 2>&1 && { graft --version >/dev/null 2>&1 || graft --help >/dev/null 2>&1; } && echo 'graft: 네이티브 모듈(tree-sitter-kotlin 등) 빌드는 실패했지만 graft 명령은 동작합니다. 일부 언어 분석이 빠질 수 있습니다. Windows 는 Visual Studio Build Tools 의 'Desktop development with C++' 를 설치한 뒤 npm install -g @nanonets/graft@0.21.1 를 다시 실행하세요' >&2; } | agents,context,code-intel | 코드베이스를 그래프로 만들어 에이전트에 연결하는 컨텍스트 레이어 CLI. 설치 때만 텔레메트리를 끈다(DO_NOT_TRACK). 프로젝트 연결은 직접 `graft init`

# --- 스펙 주도 개발 -------------------------------------------------------------------
specify | export PATH="$HOME/.local/bin:$PATH"; uv tool list 2>/dev/null \| grep -q '^specify-cli v1.1.1$' | export PATH="$HOME/.local/bin:$PATH"; uv tool install --force 'specify-cli==1.1.1' | spec,methodology,python | GitHub 공식 Spec Kit CLI(MIT). 스펙 주도 개발용 프로젝트 골격(.specify/)과 에이전트 슬래시 명령을 만든다. 설치는 CLI 만 하고, 프로젝트 적용은 직접 `specify init <이름> --integration claude`

# --- 인터넷 접근 (플랫폼별 읽기 도구 라우터) -----------------------------------------
agent-reach   | command -v agent-reach >/dev/null 2>&1 \|\| [ -x "$HOME/.local/bin/agent-reach" ] | export PATH="$HOME/.local/bin:$PATH"; uv tool install --from 'git+https://github.com/Panniantong/Agent-Reach.git@a19a171fa980a0785849596492e0af4db800c82f' agent-reach | research,web,python | Twitter/X·Reddit·YouTube·Bilibili·샤오홍슈 등 16개 플랫폼을 읽는 CLI(MIT). 검토한 커밋에 고정해 설치(PyPI 의 agent-reach 는 다른 프로젝트). 스킬과 외부 도구 설치(--system)는 자동 실행하지 않음

# --- 자율 연구 워크스페이스 ------------------------------------------------------------
orx | export PATH="$HOME/.local/bin:$PATH"; [ "$(orx --version 2>/dev/null)" = "orx 0.2.15" ] | CARGO_HOME="$HOME/.local" OPENRESEARCH_CLI_NO_MODIFY_PATH=1 bash "$AI_SETUP_ROOT/scripts/fetch-verified.sh" https://github.com/alphaXiv/OpenResearch/releases/download/v0.2.15/openresearch-cli-installer.sh 0f80ed85497023fb909c73bda301a4f0eda5e3eb09b20471c7a0cb54565c1286 | agents,autoresearch | alphaXiv OpenResearch 의 CLI(orx, MIT): 연구 에이전트용 로컬 워크스페이스·실험 트리·원격 연산 실행. v0.2.15 릴리스에 고정해 체크섬 검증 설치(~/.local/bin/orx, 셸 설정 변경 없음). 첫 실행부터 텔레메트리가 기본 켜짐 — 끄려면 `orx telemetry off`. 서버(orx up)와 스킬(orx install-skills)은 자동 실행하지 않음
pdf-inspector | npm ls -g --depth=0 @firecrawl/pdf-inspector@1.25.2 >/dev/null 2>&1 | npm install -g @firecrawl/pdf-inspector@1.25.2 | docs,pdf | Firecrawl 의 PDF 분류·텍스트 추출·Markdown 변환 CLI(Rust 기반, MIT). 텍스트 PDF 를 OCR 없이 로컬에서 빠르게 변환하고 스캔 PDF 는 detect 로 구분한다. markitdown 과 같은 용도의 대안

# --- 한국어 글쓰기 ----------------------------------------------------------------------
im-not-ai | [ -L "$HOME/.claude/skills/humanize-korean" ] | case "$(uname -s)" in MINGW*\|MSYS*\|CYGWIN*) case "${MSYS:-}" in *winsymlinks:nativestrict*) ;; *) echo 'im-not-ai: Windows(Git Bash)에서는 심볼릭 링크가 필요해 건너뜁니다. WSL/맥/리눅스에서 설치하거나(권장), 개발자 모드를 켠 뒤 MSYS=winsymlinks:nativestrict 로 다시 실행하세요. 이전 실행이 심볼릭 링크 대신 만든 복사본(~/.claude/skills 의 humanize-korean 등)이 남아 있으면 확인해 정리하세요' >&2; exit 75 ;; esac ;; esac; { command -v claude >/dev/null 2>&1 \|\| [ -d "$HOME/.claude" ]; } \|\| { echo 'im-not-ai(스킬 humanize-korean)는 Claude Code(claude 명령 또는 ~/.claude)가 필요합니다' >&2; exit 1; }; D="$HOME/.local/share/im-not-ai"; [ -d "$D/.git" ] \|\| git clone -q https://github.com/epoko77-ai/im-not-ai.git "$D"; git -C "$D" checkout -q 2f3d943d08056b612a92e12bfb72ea94dd2acd18 \|\| { git -C "$D" fetch -q origin && git -C "$D" checkout -q 2f3d943d08056b612a92e12bfb72ea94dd2acd18; }; "$D/install.sh" --claude-only | writing,korean | 한글 AI 글투 제거(번역투·기계적 병렬·관용구 등). 스킬 4개와 서브에이전트를 ~/.claude 에 심볼릭 링크로 연결(검토한 커밋에 고정, 클론은 ~/.local/share/im-not-ai 에 유지해야 함). blader/humanizer 의 한국어 짝
officecli-skills | command -v officecli >/dev/null 2>&1 && [ "$(officecli skills list 2>/dev/null \| grep -c '\[installed\]')" = 10 ] | command -v officecli >/dev/null 2>&1 \|\| { echo 'officecli-skills 는 officecli 가 먼저 필요합니다' >&2; exit 1; }; officecli skills install \|\| exit 1; for n in pptx word excel word-form morph-ppt morph-ppt-3d pitch-deck academic-paper data-dashboard financial-model; do officecli skills install "$n" \|\| exit 1; done; [ "$(officecli skills list 2>/dev/null \| grep -c '\[installed\]')" = 10 ] \|\| { echo 'officecli 스킬을 설치하지 못했습니다(감지된 에이전트가 없을 수 있음)' >&2; exit 1; } | docs,office,skills | officecli 에 내장된 스킬 11개(기본 officecli + pptx·word·excel·word-form·morph-ppt·morph-ppt-3d·pitch-deck·academic-paper·data-dashboard·financial-model)를 감지된 에이전트에 설치. 스킬이 바이너리에 내장돼 있어 고정한 officecli 버전과 항상 같다
